prefix=${pcfiledir}/../..
exec_prefix=${prefix}
includedir=${prefix}/../include
libdir=${prefix}/lib

Name: ggml
Description: The GGML Tensor Library for Machine Learning
Version: 0.26.0
Cflags: "-I${includedir}"  -DGGML_USE_CPU -DGGML_SHARED -DGGML_BACKEND_SHARED -DGGML_SHARED -DGGML_BACKEND_SHARED
Libs: "-L${libdir}" -lggml -lggml-cpu -lggml-base
Libs.private: 
Requires.private: 

